List p=18f4520 
#include <pic18f4520.inc>
CONFIG OSC = INTIO67
CONFIG WDT = OFF
org 0x00

ASSIGN MACRO addr, literal
	MOVLW	literal
	MOVWF	addr
endm

	GOTO 	test2

test1:
	ASSIGN	0x00, 0x01
	ASSIGN	0x01, 0x01
	ASSIGN	0x02, 0x02
	ASSIGN	0x03, 0x02
	ASSIGN	0x04, 0x02
	ASSIGN	0x05, 0x03
	ASSIGN	0x06, 0x04
	ASSIGN	0x07, 0x04
	GOTO	start

test2:
	ASSIGN	0x00, 0x05
	ASSIGN	0x01, 0x03
	ASSIGN	0x02, 0x05
	ASSIGN	0x03, 0x01
	ASSIGN	0x04, 0x03
	ASSIGN	0x05, 0x05
	ASSIGN	0x06, 0x07
	ASSIGN	0x07, 0x01
	GOTO	start

#define i 0x40
#define j 0x41
#define cnt 0x42
#define idx 0x43
#define newA FSR0
#define cntA FSR1
#define resA FSR2
#define arr 0x00

start:
	; arr: 0x00-0x07, res:0x10-0x17, new:0x20-0x27, cnt:0x30-0x37
	; for i 0...7
	;	cnt = 1
	;	idx = 0
	; 	for j 0...7
	; 		if arr[i] == arr[j]
	;			cnt++
	;		if arr[i] < arr[j]
	;			idx++
	;	new_arr[idx] = arr[i]
	;	cnt_arr[idx] = cnt
	;
	; for i 8...1
	;	for j 0...5
	;		if cnt_arr[j] == i
	;			res_arr[i] = new_arr[j]

	; for i 0...7
	CLRF	i
	LFSR	2, 0x000
i_loop1:

	;	cnt = 1
	;	idx = 0
	MOVLW	0
	MOVWF	cnt
	CLRF	idx

	; 	for j 0...7
	CLRF	j
	LFSR	0, 0x000
j_loop1:
	; 		if arr[i] == arr[j]
	;			cnt++
	MOVF	INDF0, w
	CPFSEQ	INDF2	;skip if equal
	GOTO	arri_neq_arrj
	INCF	cnt

arri_neq_arrj:
	;		if arr[i] < arr[j]
	;			idx++
	CPFSLT	INDF2	;skip if arr[i] < arr[j]
	GOTO	arri_nlt_arrj
	INCF	idx

arri_nlt_arrj:
	INCF	FSR0
	INCF	j
	MOVLW	8
	CPFSEQ	j
	GOTO	j_loop1
	GOTO	j_loop1_end

j_loop1_end:
	;	new_arr[idx] = arr[i]
	LFSR	0, 0x20 
	MOVF	idx, w
	ADDWF	FSR0
	MOVFF	INDF2, INDF0

	;	cnt_arr[idx] = cnt
	LFSR	1, 0x30
	MOVF	idx, w
	ADDWF	FSR1
	MOVFF	cnt, INDF1

	INCF	FSR2
	INCF	i
	MOVLW	8
	CPFSEQ	i
	GOTO	i_loop1
	GOTO	i_loop1_end

i_loop1_end:
	; idx = 0
	; for i 1...8
	;	for j 0...7
	
	MOVLW	1
	MOVWF	i
	LFSR	2, 0x10 ;res
i_loop2:
	CLRF 	j
	LFSR	1, 0x30 ;cnt
	LFSR	0, 0x20	;new
j_loop2:
	;		if cnt_arr[j] == i
	;			res_arr[idx++] = new_arr[j]	
	MOVF	INDF1, w
	CPFSEQ	i
	GOTO	neq
	MOVFF	INDF1, cnt
blablabla_loop:
	MOVF	cnt, w
	BZ		neq
	DECF	cnt
	MOVFF	INDF0, POSTINC2
	GOTO	blablabla_loop

neq:
	INCF	j
	MOVF	POSTINC0
	MOVF	POSTINC1
	MOVLW	8
	CPFSEQ	j
	GOTO	j_loop2
	GOTO	j_loop2_end
j_loop2_end:
	INCF	i
	MOVLW	9
	CPFSEQ	i
	GOTO	i_loop2

finish:
	NOP

END