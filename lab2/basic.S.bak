List p=18f4520 
    #include <pic18f4520.inc>
    CONFIG OSC = INTIO67
    CONFIG WDT = OFF
    org 0x00

    MOVLB 1                   ;set bank=1
; test case 1: 0A 33 01
test1:
    ; MOVLW 0x0A
    ; MOVWF 0x40, 1         ;[0x140] = 0x0A
    ; MOVLW 0x33
    ; MOVWF 0x41, 1         ;[0x141] = 0x33
    ; MOVLW 0x01
    ; MOVWF 0x42, 1         ;[0x142] = 0x01

; test case 2: 05 1E 15
test2:
    MOVLW 0x05
    MOVWF 0x40, 1         ;[0x140] = 0x05
    MOVLW 0x1E
    MOVWF 0x41, 1         ;[0x141] = 0x1E
    MOVLW 0x15
    MOVWF 0x42, 1         ;[0x142] = 0x15
        
    ; FSR0 = 140, FSR1 = 141, FSR2 = 142
    ; for (i = 0; i < 3; ++i) {
    ;   if (IFSR2 & 0) WREG = [FSR0++] + [FSR1++] + [FSR2++], [FSR2] = W
    ;   else WREG = [FSR2++] - [FSR1++], [FSR2] = W

    CLRF 0x03                     ;i=0, &i=0x03
    LFSR 0, 0x140                 ;FSR0 = 0x140
    LFSR 1, 0x141                 ;FSR1 = 0x141
    LFSR 2, 0x142                 ;FSR2 = 0x142
loop:
    MOVLW 0x03
    CPFSEQ 0x03
    GOTO odd
    GOTO finish

odd:
    INCF 0x03
    BTFSS INDF2, 0
    GOTO even
    MOVF POSTINC2, 0
    SUBWF POSTINC1, 0
    MOVWF INDF2
    INCF FSR0
    GOTO loop

even:
    MOVF POSTINC0, 0
    ADDWF POSTINC1, 0
    ADDWF POSTINC2, 0
    MOVWF INDF2
    GOTO loop

finish:
    NOP
    end