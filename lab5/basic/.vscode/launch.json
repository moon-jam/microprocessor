  "version": "0.2.0",
  "configurations": [

    {
      // Note: Properties here can override MPLAB project settings
      "name": "Launch basic: default",
      "type": "mplab-core-da",
      "request": "launch",
      "project": "basic",
      "configuration": "default",
      "stopOnEntry": true,
      "preLaunchTask": "basic: default - Build",
      "program": "${workspaceFolder:basic}/out/basic/default.elf"
    },
    {
      // Note: Properties here can override MPLAB project settings
      "name": "Program basic: default - Production",
      "type": "mplab-core-da",
      "request": "launch",
      "project": "basic",
      "configuration": "default",
      "noDebug": true,
      "preLaunchTask": "basic: default - Build (Production)",
      "program": "${workspaceFolder:basic}/out/basic/production/default-production.hex"
    }
  ]
}