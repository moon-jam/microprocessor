List p=18f4520 
#include <pic18f4520.inc>
CONFIG OSC = INTIO67
CONFIG WDT = OFF
org 0x00

goto test2

test1:						;0x000-0x003: 0xFF, 0x02, 0x80, 0x03
	MOVLW 0xFF
	MOVWF 0x00
	MOVLW 0x02
	MOVWF 0x01
	MOVLW 0x80
	MOVWF 0x02
	MOVLW 0x03
	MOVWF 0x03
	goto start

test2:						;0x000-0x003: 0xDC, 0xA0, 0xB0, 0x30
	MOVLW 0xDC
	MOVWF 0x00
	MOVLW 0xA0
	MOVWF 0x01
	MOVLW 0xB0
	MOVWF 0x02
	MOVLW 0x30
	MOVWF 0x03
	goto start

Mul_Add MACRO x1, x2, y1, y2
	MOVF	x1,	W
	MULWF	x2
	MOVFF	PRODH,	0x10
	MOVFF	PRODL,	0x11

	MOVF	y1,	W
	MULWF	y2
	MOVFF	PRODH,	0x12
	MOVFF	PRODL,	0x13

	MOVF	0x13,	W
	ADDWF	0x11,	F
	MOVF	0x12,	W
	ADDWFC	0x10,	F
endm

start:
	Mul_Add 0x00, 0x01, 0x02, 0x03

finish:
	NOP

END